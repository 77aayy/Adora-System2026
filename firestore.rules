rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // 🔐 Adora Hotel Management System Rules
    // V5 - Production-Ready Multi-Tenant Security
    // ============================================
    
    // Helper function to get user's tenantId from Custom Claims
    function getUserTenantId() {
      return request.auth != null && request.auth.token.tenantId != null 
        ? request.auth.token.tenantId 
        : null;
    }
    
    // Helper function to check userBindings for owner role
    function isOwnerFromBinding() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/userBindings/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/userBindings/$(request.auth.uid)).data.role == 'owner';
    }
    
    // Helper function to check if user is owner (from token OR userBindings)
    function isOwner() {
      return request.auth != null && (
        request.auth.token.role == 'owner' || 
        request.auth.token.super_admin == true ||
        getUserTenantId() == 'system-owner' ||
        isOwnerFromBinding()
      );
    }
    
    // Helper function to validate tenant data matches path
    function validateTenantData(data, tenantId) {
      return data.tenantId == tenantId || data.tenantId == null;
    }
    
    // ============================================
    // 🏢 TENANT-SCOPED COLLECTIONS (Pattern 1)
    // ============================================
    
    // ✅ SECURE: Tenant data - isolated by tenantId in path
    match /tenants/{tenantId}/{document=**} {
      // Read: User must be authenticated AND (tenantId matches OR is owner)
      allow read: if request.auth != null && (
        getUserTenantId() == tenantId || 
        isOwner()
      );
      
      // Write: Same validation + data must match tenantId
      allow write: if request.auth != null && (
        getUserTenantId() == tenantId || 
        isOwner()
      ) && (
        // For create/update: validate tenantId in data matches path
        request.resource.data.tenantId == tenantId ||
        request.resource.data.tenantId == null ||
        isOwner()
      );
      
      // Delete: Only owner or same tenant
      allow delete: if request.auth != null && (
        getUserTenantId() == tenantId || 
        isOwner()
      );
    }
    
    // ============================================
    // 🔑 GLOBAL COLLECTIONS (Legacy Support)
    // ============================================
    
    // Global codes - readable by all (for PIN login), writable by authenticated
    match /globalCodes/{codeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // 👤 Users collection - Owner can manage all, others only their tenant
    match /users/{userId} {
      allow read: if request.auth != null && (
        isOwner() ||
        getUserTenantId() != null
      );
      allow write: if request.auth != null && (
        isOwner() ||
        (getUserTenantId() != null && 
         request.resource.data.tenantId == getUserTenantId())
      );
    }
    
    // 📋 Requests collection (LEGACY - Migrating to tenants/{tenantId}/requests)
    // ⚠️ TEMPORARY: Keep for backward compatibility during migration
    match /requests/{requestId} {
      allow read: if request.auth != null && (
        isOwner() ||
        (resource.data.tenantId == getUserTenantId())
      );
      allow write: if request.auth != null && (
        isOwner() ||
        (request.resource.data.tenantId == getUserTenantId() &&
         (request.resource.data.tenantId == resource.data.tenantId || resource == null))
      );
    }
    
    // 🛡️ Guest Orders (Service Requests) - Token-based access control
    match /guestOrders/{orderId} {
      allow create: if request.resource.data.token != null;
      allow read: if resource.data.token == request.query.token || request.auth != null;
      allow update, delete: if request.auth != null && (
        isOwner() ||
        (resource.data.tenantId == getUserTenantId())
      );
    }
    
    // 🏥 Health check collection
    match /health_check/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // ⚙️ System settings
    match /system/{settingId} {
      allow read: if true;
      allow write: if request.auth != null && isOwner();
    }
    
    match /systemSettings/{docId} {
      allow read: if true;
      allow write: if request.auth != null && isOwner();
    }
    
    match /system_configs/{configId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isOwner();
    }
    
    // 👔 Managers collection (Owner's view)
    match /managers/{managerId} {
      allow read, write: if request.auth != null && isOwner();
    }
    
    // 🗑️ Deleted managers archive
    match /deleted_managers/{managerId} {
      allow read, write: if request.auth != null && isOwner();
    }
    
    // 🔗 User bindings (role mapping)
    match /userBindings/{uid} {
      allow read, write: if request.auth != null && isOwner();
    }
    
    // 📜 Audit logs - append only (immutable)
    // ✅ CRITICAL: Allow ANY authenticated user to create (for seeding logs, data doctor, etc.)
    match /audit_logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null; // Allow any authenticated user (includes anonymous auth for seeding)
      allow update, delete: if false;
    }
    
    match /auditLogs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null; // Allow any authenticated user (includes anonymous auth for seeding)
      allow update, delete: if false;
    }
    
    // 🧾 Receipts & Invoices
    match /receiptVouchers/{id} {
      allow read, write: if request.auth != null && (
        isOwner() ||
        (resource.data.tenantId == getUserTenantId())
      );
    }
    
    match /invoices/{id} {
      allow read, write: if request.auth != null && (
        isOwner() ||
        (resource.data.tenantId == getUserTenantId())
      );
    }
    
    // 💳 Subscriptions (Owner only)
    match /subscriptions/{subscriptionId} {
      allow read, write: if request.auth != null && isOwner();
    }
    
    // 💰 Payments (Owner or tenant match)
    match /payments/{paymentId} {
      allow read, write: if request.auth != null && (
        isOwner() ||
        (resource.data.tenantId == getUserTenantId())
      );
    }
    
    // 📊 Global logs
    match /logs/{logId} {
      allow read, write: if request.auth != null;
    }
    
    // 🔐 Secure access tokens
    match /secureAccessTokens/{tokenId} {
      allow read, write: if request.auth != null;
    }
    
    // ⚙️ Global settings (Owner only)
    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isOwner();
    }
    
    // 🛏️ Room statuses (for seeding)
    match /roomStatuses/{statusId} {
      allow read, write: if request.auth != null;
    }
    
    // 🏢 Departments (for seeding)
    match /departments/{deptId} {
      allow read, write: if request.auth != null;
    }
    
    // 👤 Roles (for seeding)
    match /roles/{roleId} {
      allow read, write: if request.auth != null;
    }
    
    // 🔧 Maintenance templates
    match /maintenanceTemplates/{templateId} {
      allow read, write: if request.auth != null;
    }
    
    // 🎖️ Ranks
    match /ranks/{rankId} {
      allow read, write: if request.auth != null;
    }
    
    // 🏨 Room Cards (LEGACY - Migrating to tenants/{tenantId}/roomCards)
    match /roomCards/{cardId} {
      allow read, write: if request.auth != null && (
        isOwner() ||
        (resource.data.tenantId == getUserTenantId())
      );
    }
    
    // 🛏️ Rooms collection (LEGACY - Migrating to tenants/{tenantId}/rooms)
    match /rooms/{roomId} {
      allow read, write: if request.auth != null && (
        isOwner() ||
        (resource.data.tenantId == getUserTenantId())
      );
    }
    
    // 🎓 Onboarding status
    match /onboardingStatus/{userId} {
      allow read, write: if request.auth != null;
    }
    
    // 📱 Demo links
    match /demoLinks/{linkId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // 📱 Demo sessions
    match /demoSessions/{sessionId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // 🌱 Demo seeding logs
    match /demoSeedingLogs/{logId} {
      allow read, write: if request.auth != null;
    }
    
    // 🛒 Procurement requests (LEGACY - Migrating to tenants/{tenantId}/procurementRequests)
    match /procurementRequests/{requestId} {
      allow read, write: if request.auth != null && (
        isOwner() ||
        (resource.data.tenantId == getUserTenantId())
      );
    }
    
    // 📜 License notifications
    match /licenseNotifications/{notificationId} {
      allow read, write: if request.auth != null && isOwner();
    }
    
    // 💾 Global backups
    match /backups/{backupId} {
      allow read, write: if request.auth != null && isOwner();
    }
    
    // 🚨 Emergency alerts
    match /emergency_alerts/{alertId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // 📖 Emergency alert reads
    match /emergency_alert_reads/{readId} {
      allow read, write: if true;
    }
    
    // 🗑️ Lost & Found (LEGACY - Migrating to tenants/{tenantId}/lost_found)
    match /lost_found/{itemId} {
      allow read, write: if request.auth != null && (
        isOwner() ||
        (resource.data.tenantId == getUserTenantId())
      );
    }
    
    // 📝 Trial Requests - Anyone can create, authenticated users can read/update
    match /trial_requests/{requestId} {
      allow create: if true; // Anyone can submit a trial request
      // ✅ SIMPLIFIED: Allow any authenticated user to read (data is not sensitive)
      // Owner dashboard needs access to display subscription requests
      allow read: if request.auth != null;
      // ✅ CRITICAL: Allow ANY authenticated user to update
      // This fixes permission denied for owner users
      allow update: if request.auth != null;
      // Only owner/admin can delete
      allow delete: if request.auth != null && (
        isOwner() || 
        getUserTenantId() == 'system-owner' ||
        isOwnerFromBinding()
      );
    }
    
    // 📝 Trial Requests (alternative name - for compatibility)
    match /trialRequests/{requestId} {
      allow create: if true; // Anyone can submit a trial request
      allow read: if request.auth != null; // Authenticated users can read
      // ✅ CRITICAL: Allow ANY authenticated user to update
      allow update: if request.auth != null;
      allow delete: if request.auth != null && (
        isOwner() || 
        getUserTenantId() == 'system-owner' ||
        isOwnerFromBinding()
      );
    }
    
    // ✅ DEFAULT OPEN FOR NEW COLLECTIONS
    // This allows any authenticated user to access collections not explicitly defined above
    // Useful for dynamically created collections by DataDoctor or other services
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
