rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // 🔐 Adora Hotel Management System Rules
    // V6 - SIMPLIFIED for Cloud Functions Architecture
    // ✅ Strategy: Read-only for clients, Write via Functions (Admin SDK)
    // ============================================
    
    // Helper function to check if user is owner
    // ✅ FIX: Work with both Anonymous Auth (Spark) and Custom Claims (Blaze)
    function isOwner() {
      return request.auth != null && (
        // ✅ Blaze Plan: Check Custom Claims (set by Cloud Functions)
        request.auth.token.role == 'owner' || 
        request.auth.token.super_admin == true ||
        // ✅ Spark Plan Fallback: Check userBindings collection for owner role
        // This works even if Custom Claims are not set (Anonymous Auth only)
        (exists(/databases/$(database)/documents/userBindings/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/userBindings/$(request.auth.uid)).data.role == 'owner')
      );
    }
    
    // Helper to get tenantId from userBindings
    function getUserTenantId() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/userBindings/$(request.auth.uid))
        ? get(/databases/$(database)/documents/userBindings/$(request.auth.uid)).data.tenantId
        : null;
    }
    
    // ============================================
    // 🔑 PUBLIC COLLECTIONS (Read-only for authenticated)
    // ============================================
    
    // Global codes - readable by all authenticated users (for PIN lookup via Functions)
    match /globalCodes/{codeId} {
      allow read: if request.auth != null;
      allow write: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // System settings - readable by all authenticated users
    match /system/{settingId} {
      allow read: if request.auth != null;
      allow write: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    match /systemSettings/{docId} {
      allow read: if request.auth != null;
      allow write: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // ============================================
    // 👤 USER COLLECTIONS
    // ============================================
    
    // User bindings - users can read their own, owner can read all
    // ✅ CRITICAL: Allow users to create/update their OWN binding (for owner login)
    match /userBindings/{uid} {
      allow read: if request.auth != null && (
        request.auth.uid == uid || 
        isOwner()
      );
      // ✅ Allow users to create/update their OWN binding (needed for owner login)
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // Users collection - read by authenticated (tenant filtering in Functions)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // Login attempts - readable by authenticated (rate limiting handled in Functions)
    match /loginAttempts/{attemptId} {
      allow read: if request.auth != null;
      allow write: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // ============================================
    // 🏢 TENANT-SCOPED COLLECTIONS
    // ============================================
    
    // Tenant data - read by authenticated (tenant filtering in Functions)
    match /tenants/{tenantId}/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // ============================================
    // 📋 BUSINESS COLLECTIONS (Read-only)
    // ============================================
    
    // Requests
    match /requests/{requestId} {
      allow read: if request.auth != null;
      allow write: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // Guest orders
    match /guestOrders/{orderId} {
      allow read: if request.auth != null;
      allow write: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // Rooms
    match /rooms/{roomId} {
      allow read: if request.auth != null;
      allow write: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // Room cards
    match /roomCards/{cardId} {
      allow read: if request.auth != null;
      allow write: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // Procurement requests
    match /procurementRequests/{requestId} {
      allow read: if request.auth != null;
      allow write: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // Lost & Found
    match /lost_found/{itemId} {
      allow read: if request.auth != null;
      allow write: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // ============================================
    // 🔧 ADMIN COLLECTIONS
    // ============================================
    
    // Managers (Owner only)
    match /managers/{managerId} {
      allow read: if request.auth != null && isOwner();
      allow write: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // Trial requests (authenticated can read, create)
    match /trial_requests/{requestId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    match /trialRequests/{requestId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null;
      allow update, delete: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // ============================================
    // 💰 BILLING & FINANCIAL COLLECTIONS
    // ============================================
    
    // Receipt vouchers (سندات القبض) - Owner can read all, authenticated users can read
    match /receiptVouchers/{voucherId} {
      allow read: if request.auth != null;
      allow write: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // Expense vouchers (سندات الصرف) - Owner can read all, authenticated users can read
    match /expenseVouchers/{voucherId} {
      allow read: if request.auth != null;
      allow write: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // Invoices - Owner can read all, authenticated users can read
    match /invoices/{invoiceId} {
      allow read: if request.auth != null;
      allow write: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // Subscriptions - Owner can read all, authenticated users can read
    match /subscriptions/{subscriptionId} {
      allow read: if request.auth != null;
      allow write: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // Payments - Owner can read all, authenticated users can read
    match /payments/{paymentId} {
      allow read: if request.auth != null;
      allow write: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // Deleted billing records - Owner only
    match /deleted_billing_records/{recordId} {
      allow read: if request.auth != null && isOwner();
      allow write: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // ============================================
    // 📊 LOGS & AUDIT (Read-only)
    // ============================================
    
    // Audit logs
    match /audit_logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null; // Allow client-side logging
      allow update, delete: if false;
    }
    
    match /auditLogs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    
    // Data doctor logs
    match /data_doctor_logs/{logId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
    
    // ============================================
    // 🗑️ DELETED MANAGERS (Owner only)
    // ============================================
    
    match /deleted_managers/{managerId} {
      allow read: if request.auth != null && isOwner();
      allow write: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // ============================================
    // 🌐 PUBLIC READ COLLECTIONS
    // ============================================
    
    // Health check
    match /health_check/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Emergency alerts (public read)
    match /emergency_alerts/{alertId} {
      allow read: if true;
      allow write: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // Demo links (public read)
    match /demoLinks/{linkId} {
      allow read: if true;
      allow write: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // ============================================
    // 🏥 HEALTH REPORTS (Owner & Authenticated)
    // ============================================
    
    // Health reports - Owner can read all, authenticated users can read their tenant's reports
    match /health_reports/{reportId} {
      allow read: if request.auth != null; // ✅ All authenticated users can read (tenant filtering in code)
      allow write: if request.auth != null; // ✅ Allow client to create/update reports
    }
    
    // Owner notifications - Owner only
    match /ownerNotifications/{notificationId} {
      allow read: if request.auth != null && isOwner();
      allow write: if false; // ✅ Only via Cloud Functions (Admin SDK)
    }
    
    // ============================================
    // ⚠️ DEFAULT DENY - Force explicit rules
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
