{
    "name": "adora-hotel-system",
    "version": "3.0.0",
    "description": "Adora Hotel Management System V3 - نظام إدارة الفنادق الذكي SaaS Multi-Tenant",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:typecheck": "tsc && vite build",
        "typecheck": "tsc --noEmit",
        "preview": "vite preview",
        "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
        "lint:fix": "eslint . --ext .ts,.tsx --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\"",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "deploy-fb": "npm run build && firebase deploy --only hosting",
        "translation-audit": "node scripts/translation-audit.mjs"
    },
    "dependencies": {
        "@google/generative-ai": "^0.24.1",
        "@types/lodash": "^4.17.21",
        "canvas-confetti": "^1.9.4",
        "chart.js": "^4.5.1",
        "firebase": "^10.7.0",
        "i18next": "^23.16.8",
        "i18next-browser-languagedetector": "^7.2.2",
        "jspdf": "^3.0.4",
        "jspdf-autotable": "^5.0.7",
        "lodash": "^4.17.21",
        "lodash-es": "^4.17.22",
        "lucide-react": "^0.562.0",
        "react": "^18.2.0",
        "react-chartjs-2": "^5.3.1",
        "react-dom": "^18.2.0",
        "react-i18next": "^14.1.3",
        "react-router-dom": "^6.20.0",
        "recharts": "^2.12.7",
        "xlsx": "^0.18.5",
        "zod": "^4.3.4"
    },
    "devDependencies": {
        "@playwright/test": "^1.58.2",
        "@types/canvas-confetti": "^1.9.0",
        "@types/react": "^18.2.0",
        "@types/react-dom": "^18.3.7",
        "@typescript-eslint/eslint-plugin": "^6.0.0",
        "@typescript-eslint/parser": "^6.0.0",
        "@vitejs/plugin-react": "^4.2.0",
        "autoprefixer": "^10.4.0",
        "eslint": "^8.57.0",
        "eslint-plugin-react": "^7.33.0",
        "eslint-plugin-react-hooks": "^4.6.0",
        "jsdom": "^24.0.0",
        "postcss": "^8.4.0",
        "prettier": "^3.0.0",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.3.0",
        "vite": "^5.0.0",
        "vite-plugin-pwa": "^0.17.0",
        "vitest": "^1.2.0"
    }
}
